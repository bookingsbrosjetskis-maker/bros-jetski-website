# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local database (contains the admin password hash + customer PII — never commit)
*.db
*.db-journal
/prisma/*.db
/prisma/*.db-journal

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# admin-uploaded gallery media (dev local storage)
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# portable Git for Windows installation that lives in this folder (NOT project files)
/bin/
/cmd/
/dev/
/etc/
/mingw64/
/proc/
/tmp/
/usr/
/git-bash.exe
/git-cmd.exe
/unins000.dat
/unins000.exe
/unins000.msg
/LICENSE.txt
/ReleaseNotes.html

# typescript
*.tsbuildinfo
next-env.d.ts
